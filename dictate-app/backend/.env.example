# Copy to .env and enter values locally. Never commit .env or put service keys in the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Needed only for the related live provider feature.
DEEPGRAM_API_KEY=
# Optional: used only when ai.ner_enabled is true in config.yaml.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Google AI Studio key for the configured Gemini or Gemma model.
GEMINI_API_KEY=
